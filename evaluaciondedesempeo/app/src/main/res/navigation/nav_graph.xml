<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_dashboard">

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.evaluaciondedesempeo.ui.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_evaluations"
        android:name="com.example.evaluaciondedesempeo.ui.EvaluationsFragment"
        android:label="Evaluaciones"
        tools:layout="@layout/fragment_evaluations">
        <action
            android:id="@+id/action_navigation_evaluations_to_newEvaluationFragment"
            app:destination="@id/newEvaluationFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.evaluaciondedesempeo.ui.ProfileFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/newEvaluationFragment"
        android:name="com.example.evaluaciondedesempeo.ui.NewEvaluationFragment"
        android:label="Nueva Evaluación"
        tools:layout="@layout/fragment_new_evaluation" />
</navigation>