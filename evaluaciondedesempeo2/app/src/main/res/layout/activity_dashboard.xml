<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Header con Degradado Suave -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#4F46E5"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivDashboardLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_logo_insight"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBrandName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="InsightHR"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        app:layout_constraintBottom_toBottomOf="@id/ivDashboardLogo"
        app:layout_constraintStart_toEndOf="@id/ivDashboardLogo"
        app:layout_constraintTop_toTopOf="@id/ivDashboardLogo" />

    <ImageButton
        android:id="@+id/btnLogout"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_lock_power_off"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/tvBrandName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvBrandName" />

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        android:text="Hola, Administrador"
        android:textColor="#E0E7FF"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivDashboardLogo" />

    <!-- Tarjeta de KPIs Flotante -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvKpi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvUserName">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:weightSum="3">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCORE" android:textSize="10sp" android:textColor="#94A3B8" android:textStyle="bold"/>
                <TextView android:id="@+id/tvKpiScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" android:textColor="#1E1B4B" android:fontFamily="sans-serif-black"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#F1F5F9" android:layout_gravity="center"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVALS" android:textSize="10sp" android:textColor="#94A3B8" android:textStyle="bold"/>
                <TextView android:id="@+id/tvKpiEvals" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" android:textColor="#1E1B4B" android:fontFamily="sans-serif-black"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="40dp" android:background="#F1F5F9" android:layout_gravity="center"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALERTAS" android:textSize="10sp" android:textColor="#94A3B8" android:textStyle="bold"/>
                <TextView android:id="@+id/tvKpiAlerts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" android:textColor="#EF4444" android:fontFamily="sans-serif-black"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        android:text="GESTIÓN ESTRATÉGICA DE TALENTO"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:fontFamily="sans-serif-black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvKpi" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmployees"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle" />

    <!-- Panel de Acciones Inferior Estilo "Floating Bottom Bar" -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutActionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:id="@+id/layoutAdminPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterWorker"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:text="NUEVO"
                    android:textSize="11sp"
                    app:cornerRadius="16dp"
                    android:layout_marginEnd="6dp"
                    app:strokeColor="#6366F1"
                    android:textColor="#6366F1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewEvaluation"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:text="AUDITORÍA"
                    android:textSize="11sp"
                    app:cornerRadius="16dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#6366F1"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewMyResults"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="MI REPORTE ESTRATÉGICO"
                android:fontFamily="sans-serif-black"
                android:backgroundTint="#10B981"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
