<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/headerView"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#6366F1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="INTELIGENCIA DE DESEMPEÑO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRadar"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-40dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/headerView">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvEmployeeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Colaborador"
                    android:textColor="#1E293B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KPIs ESTRATÉGICOS (MÉTODO 360°)"
                    android:textColor="#6366F1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"/>

                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/radarChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutKPIs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardRadar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PILARES DE DESEMPEÑO"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"
                android:textAllCaps="true"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eficiencia Operativa" android:textSize="12sp" android:textColor="#475569" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressEficiencia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:indicatorColor="#6366F1"
                            app:trackColor="#F1F5F9"
                            app:trackThickness="8dp"
                            app:trackCornerRadius="4dp"
                            android:progress="75"/>
                        <TextView android:id="@+id/tvEficienciaScore" android:layout_width="45dp" android:layout_height="wrap_content" android:text="75%" android:gravity="end" android:textStyle="bold" android:textColor="#6366F1"/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Competencias Blandas" android:textSize="12sp" android:textColor="#475569" android:textStyle="bold" android:layout_marginTop="20dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressBlandas"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:indicatorColor="#10B981"
                            app:trackColor="#F1F5F9"
                            app:trackThickness="8dp"
                            app:trackCornerRadius="4dp"
                            android:progress="85"/>
                        <TextView android:id="@+id/tvBlandasScore" android:layout_width="45dp" android:layout_height="wrap_content" android:text="85%" android:gravity="end" android:textStyle="bold" android:textColor="#10B981"/>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Potencial y Crecimiento" android:textSize="12sp" android:textColor="#475569" android:textStyle="bold" android:layout_marginTop="20dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressPotencial"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:indicatorColor="#F59E0B"
                            app:trackColor="#F1F5F9"
                            app:trackThickness="8dp"
                            app:trackCornerRadius="4dp"
                            android:progress="60"/>
                        <TextView android:id="@+id/tvPotencialScore" android:layout_width="45dp" android:layout_height="wrap_content" android:text="60%" android:gravity="end" android:textStyle="bold" android:textColor="#F59E0B"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#EEF2FF"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutKPIs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View android:layout_width="4dp" android:layout_height="20dp" android:background="#6366F1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="INSIGHTS DE IA" android:textColor="#1E293B" android:textStyle="bold" android:textSize="14sp" android:textAllCaps="true" android:letterSpacing="0.05"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSentiment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Sentimiento: Analizando..."
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Analizando feedback estratégico..."
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadReport"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:text="GENERAR REPORTE PDF"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="#FFFFFF"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardIA"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:text="FINALIZAR REVISIÓN"
            android:textColor="#6366F1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#6366F1"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnDownloadReport"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
