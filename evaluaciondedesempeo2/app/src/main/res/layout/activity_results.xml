<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header Indigo -->
        <View
            android:id="@+id/headerView"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#4F46E5"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="INTELIGENCIA ESTRATÉGICA"
            android:textColor="#E0E7FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEmployeeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nombre del Colaborador"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Tarjeta del Radar Chart -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRadar"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tvEmployeeName">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESEMPEÑO 360°"
                    android:textColor="#6366F1"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1" />

                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/radarChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pilares de Desempeño -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardKPIs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/cardRadar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EFICIENCIA OPERATIVA" android:textSize="10sp" android:textColor="#94A3B8" android:fontFamily="sans-serif-black"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressEficiencia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:indicatorColor="#6366F1"
                        app:trackColor="#F1F5F9"
                        app:trackThickness="10dp"
                        app:trackCornerRadius="5dp"
                        android:progress="70"/>
                    <TextView android:id="@+id/tvEficienciaScore" android:layout_width="45dp" android:layout_height="wrap_content" android:text="70%" android:gravity="end" android:fontFamily="sans-serif-black" android:textColor="#1E1B4B"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMPETENCIAS BLANDAS" android:textSize="10sp" android:textColor="#94A3B8" android:fontFamily="sans-serif-black" android:layout_marginTop="20dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBlandas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:indicatorColor="#10B981"
                        app:trackColor="#F1F5F9"
                        app:trackThickness="10dp"
                        app:trackCornerRadius="5dp"
                        android:progress="85"/>
                    <TextView android:id="@+id/tvBlandasScore" android:layout_width="45dp" android:layout_height="wrap_content" android:text="85%" android:gravity="end" android:fontFamily="sans-serif-black" android:textColor="#1E1B4B"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POTENCIAL Y CRECIMIENTO" android:textSize="10sp" android:textColor="#94A3B8" android:fontFamily="sans-serif-black" android:layout_marginTop="20dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressPotencial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:indicatorColor="#F59E0B"
                        app:trackColor="#F1F5F9"
                        app:trackThickness="10dp"
                        app:trackCornerRadius="5dp"
                        android:progress="60"/>
                    <TextView android:id="@+id/tvPotencialScore" android:layout_width="45dp" android:layout_height="wrap_content" android:text="60%" android:gravity="end" android:fontFamily="sans-serif-black" android:textColor="#1E1B4B"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Insights de IA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="#EEF2FF"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardKPIs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ANALÍTICA INSIGHT AI" android:textColor="#4338CA" android:fontFamily="sans-serif-black" android:textSize="11sp" android:letterSpacing="0.1"/>

                <TextView
                    android:id="@+id/tvSentiment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Cargando análisis emocional..."
                    android:textColor="#1E1B4B"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tvRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Generando recomendaciones tácticas basadas en el desempeño actual..."
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadReport"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:text="GENERAR REPORTE ESTRATÉGICO"
            android:fontFamily="sans-serif-black"
            android:backgroundTint="#10B981"
            app:cornerRadius="18dp"
            app:layout_constraintTop_toBottomOf="@id/cardIA"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="VOLVER AL PANEL"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:fontFamily="sans-serif-black"
            app:layout_constraintTop_toBottomOf="@id/btnDownloadReport"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
